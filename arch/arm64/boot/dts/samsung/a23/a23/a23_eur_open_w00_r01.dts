		#gpio-cells = <2>;

		pinctrl-names = "default";
		pinctrl-0 = <&expander_reset_active
		>;

		reset-gpios = <SEC_GPIO_REF(AP,tlmm,45) 1>;
		pca953x,gpio_start = <150>;
		pca953x,gpio_num = <24>;
	};
};


