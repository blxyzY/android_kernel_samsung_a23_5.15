			59	231	242	316
			60	243	254	333
			61	255	255	360
		>;


		/*
		* ************************************************************************************************************************
		* DMS (Dynamic Mode Switch)
		* (PBA does not support MULTI_RESOLUTION, only FHD.)
		* ************************************************************************************************************************
		*/

		qcom,mdss-dsi-display-timings {
			fhd@0 {
				qcom,display-topology = <1 0 1>;
				qcom,default-topology-index = <0>;

				qcom,mdss-dsi-panel-width = <1080>;
				qcom,mdss-dsi-panel-height = <1920>;
				qcom,mdss-dsi-panel-framerate = <60>;
				qcom,mdss-dsi-h-pulse-width = <12>;
				qcom,mdss-dsi-h-back-porch = <32>;
				qcom,mdss-dsi-h-front-porch = <164>;
				qcom,mdss-dsi-h-sync-skew = <0>;
				qcom,mdss-dsi-v-pulse-width = <4>;
				qcom,mdss-dsi-v-back-porch = <3>;
				qcom,mdss-dsi-v-front-porch = <9>;

				qcom,mdss-dsi-panel-clockrate = <898000000>;
				qcom,mdss-dsi-panel-phy-timings = [00 1B 08 07 0D 0B 08 08 05 02 04 00 17 0C];

				qcom,mdss-dsi-on-command = [
					39 01 00 00 78 00 02 11 00	/* sleep out.  It use last packet*/
				];
				qcom,mdss-dsi-off-command = [
					05 01 00 00 24 00 01 28				/* wait 40ms(0x24) */
					05 01 00 00 78 00 01 10				/* wait 120ms(0x78) */
				];

				qcom,mdss-dsi-on-command-state = "dsi_hs_mode";
				qcom,mdss-dsi-off-command-state = "dsi_hs_mode";
			};
		};
	};
};

/* from a23/a23_eur_open_w00_r08.dts */
&ss_dsi_panel_PBA_BOOTING_FHD {
	qcom,display-type = "primary";
	qcom,dsi-ctrl-num = <0>;
	qcom,dsi-phy-num = <0>;

	/delete-property/ qcom,panel-mode-gpio;

	qcom,platform-reset-gpio = <SEC_GPIO_REF(AP,tlmm,111) 0>;

	qcom,panel-supply-entries
	{
		#address-cells = <1>;
		#size-cells = <0>;

	};
};

