W 0x1F 0x3E
W 0x6D 0x7A
W 0x70 0x00
W 0x6B 0x05
W 0xFF 0x78 0x07 0x00
W 0x53 0x2C
W 0x55 0x01
						    W 0x11
Delay 60ms
W 0x29";
		samsung,mdss_dsi_on_tx_cmds_revA_lp; /* Without this feature, whole ss commands be sent on HS mode */

		samsung,mdss_dsi_off_tx_cmds_revA = "W 0x28
Delay 20ms
W 0x10
Delay 80ms";

		qcom,mdss-dsi-display-timings {
			fhd {
				qcom,display-topology = <1 1 1>;
				qcom,default-topology-index = <0>;

				qcom,mdss-dsi-panel-width = <1080>;
				qcom,mdss-dsi-panel-height = <2408>;

				qcom,mdss-dsi-h-pulse-width = <60>;
				qcom,mdss-dsi-h-back-porch = <200>;
				qcom,mdss-dsi-h-front-porch = <210>;
				qcom,mdss-dsi-h-sync-skew = <0>;
				qcom,mdss-dsi-v-pulse-width = <4>;
				qcom,mdss-dsi-v-back-porch = <40>;
				qcom,mdss-dsi-v-front-porch = <40>;
				qcom,mdss-dsi-panel-clockrate = <1125000000>; /* 1125 Mbps*/

				qcom,mdss-dsi-panel-phy-timings = [00 25 0A 0A 1B 24 0A 0A 0A 02 04 00 1F 0F];

				qcom,mdss-dsi-t-clk-pre = <0x1F>;
				qcom,mdss-dsi-t-clk-post = <0x0F>;

				qcom,mdss-dsi-panel-framerate = <90>;
				/* qcom,mdss-mdp-transfer-time-us = <7533>; */

				/*qcom,mdss-dsi-timing-switch-command; use samsung,panel_multires_XXX instead*/
				/*qcom,mdss-dsi-timing-switch-command-state;*/

				qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
				qcom,mdss-dsi-off-command-state = "dsi_hs_mode";

				qcom,compression-mode = "dsc";
				qcom,mdss-dsc-version = <0x11>;
				qcom,mdss-dsc-scr-version = <0>;
				qcom,mdss-dsc-slice-height = <8>;
				qcom,mdss-dsc-slice-width = <540>;
				qcom,mdss-dsc-slice-per-pkt = <1>;
				qcom,mdss-dsc-bit-per-component = <8>;
				qcom,mdss-dsc-bit-per-pixel = <8>;
				qcom,mdss-dsc-block-prediction-enable;
			};
		};
	};
};

/* from a23/a23_eur_open_w00_r08.dts */
&A23_ILI7807S_BS066FBM {
	qcom,display-type = "primary";
	qcom,dsi-ctrl-num = <0>;
	qcom,dsi-phy-num = <0>;

	/delete-property/ qcom,panel-mode-gpio;


	samsung,ub-con-det = <SEC_GPIO_REF(AP,tlmm,19) 0>;

	samsung,esd-irq-gpio1 = <SEC_GPIO_REF(AP,tlmm,35) 0>; /* DISP_DET */


	qcom,panel-supply-entries
	{
		#address-cells = <1>;
		#size-cells = <0>;

		/* display: 1.8V -> 1ms -> 5.5V -> 10ms -> reset high -> LP11
		 * -> reset low -> 3ms -> reset high -> 10ms -> command
		 */
		qcom,panel-supply-entry@0 {
			reg = <0>;
			qcom,supply-name = "lcd_vddi"; /* VDD 1.8V */
			qcom,supply-min-voltage = <1800000>;
			qcom,supply-max-voltage = <1800000>;
			qcom,supply-enable-load = <100000>;
			qcom,supply-disable-load = <100>;
			qcom,supply-pre-on-sleep = <0>; /* unit is ms*/
			qcom,supply-post-on-sleep = <2>; /* spec. is 1ms, but vddi raises slowly.. */
			qcom,supply-post-off-sleep = <32>;
		};

		qcom,panel-supply-entry@1 {
			reg = <1>;
			qcom,supply-name = "lcd_vsp";
			qcom,supply-min-voltage = <1800000>;
			qcom,supply-max-voltage = <1800000>;
			qcom,supply-enable-load = <100000>;
			qcom,supply-disable-load = <100>;
			qcom,supply-pre-on-sleep = <0>; /* unit is ms*/
			qcom,supply-post-on-sleep = <4>;
			qcom,supply-post-off-sleep = <4>;
		};
		qcom,panel-supply-entry@2 {
			reg = <2>;
			qcom,supply-name = "lcd_vsn";
			qcom,supply-min-voltage = <1800000>;
			qcom,supply-max-voltage = <1800000>;
			qcom,supply-enable-load = <100000>;
			qcom,supply-disable-load = <100>;
			qcom,supply-pre-on-sleep = <0>; /* unit is ms*/
			qcom,supply-post-on-sleep = <13>;
			qcom,supply-post-off-sleep = <2>;
		};

		qcom,panel-supply-entry@4 {
			reg = <4>;
			qcom,supply-name = "lcd_rst";
			qcom,supply-min-voltage = <1800000>;
			qcom,supply-max-voltage = <1800000>;
			qcom,supply-enable-load = <100000>;
			qcom,supply-disable-load = <100>;
			qcom,supply-pre-on-sleep = <0>; /* unit is ms*/
			qcom,supply-post-on-sleep = <10>;
			qcom,supply-post-off-sleep = <2>;
		};
	};
};

